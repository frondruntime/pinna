{
  "name": "@frondruntime/pinna-effect",
  "version": "0.2.0",
  "description": "Pinna on Effect Schema: checked boxes, model classes, decoding, and Effect programs.",
  "license": "MIT",
  "author": {
    "name": "Roman Dubinin",
    "url": "https://romanonthego.dev"
  },
  "homepage": "https://pinna.frondruntime.dev",
  "bugs": {
    "url": "https://github.com/frondruntime/pinna/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frondruntime/pinna.git",
    "directory": "packages/pinna-effect"
  },
  "keywords": [
    "reactive",
    "state",
    "effect",
    "schema"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "bun": ">=1"
  },
  "scripts": {
    "build": "bun ../../scripts/release.ts build pinna-effect",
    "prepack": "bun run build",
    "test": "BUN_JSC_useConcurrentJIT=0 bun --conditions=source test ./test",
    "typecheck": "bunx tsc -p tsconfig.json --noEmit",
    "bench:data": "bun --conditions=source bench/data.ts",
    "bench:hermes": "bun --conditions=source bench/hermes.ts",
    "bench:blackbox": "bun --conditions=source bench/blackbox.ts",
    "bench:stage": "bun --conditions=source bench/stage.ts",
    "bench:hermes-blackbox": "bun --conditions=source bench/hermes-blackbox.ts"
  },
  "peerDependencies": {
    "@frondruntime/pinna": "0.2.0",
    "effect": "^4.1.0"
  },
  "devDependencies": {
    "@frondruntime/pinna": "workspace:*",
    "@frondruntime/pinna-core": "workspace:*",
    "effect": "4.1.0",
    "mobx": "7.1.7"
  }
}
