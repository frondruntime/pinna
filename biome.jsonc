{
  "$schema": "https://biomejs.dev/schemas/2.4.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": ["**", "!bun.lock", "!node_modules", "!.claude"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "html": {
    "experimentalFullSupportEnabled": true
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": {
        // `noPropertyAccessFromIndexSignature` in tsconfig.base.json requires `record["key"]` on an
        // index signature, which this rule rewrites to `record.key`, a type error.
        "useLiteralKeys": "off"
      }
    }
  },
  "overrides": [
    {
      // The 3D scene indexes fixed-length colors, matrices, and faces, which
      // `noUncheckedIndexedAccess` types as possibly undefined; each `!` marks an index in range.
      "includes": ["apps/site/src/lib/frondScene.ts"],
      "linter": { "rules": { "style": { "noNonNullAssertion": "off" } } }
    }
  ]
}
