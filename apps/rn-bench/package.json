{
  "name": "@frondruntime/pinna-rn-bench",
  "version": "0.0.0",
  "private": true,
  "description": "Pinna, MobX, alien-signals, and Legend State in a React Native app, each through its own library's tools, kept to one reactive shape: plain values, a LegendList, a details screen.",
  "main": "index.ts",
  "scripts": {
    "prebuild": "expo prebuild --platform ios --no-install",
    "ios": "expo run:ios --configuration Release",
    "start": "expo start",
    "test": "bun --conditions=source test ./test",
    "typecheck": "bunx tsc -p tsconfig.json --noEmit",
    "bench": "bun --conditions=source scripts/collect.ts",
    "bundle": "expo export --platform ios --output-dir .expo/bundle"
  },
  "dependencies": {
    "@frondruntime/pinna": "workspace:*",
    "@frondruntime/pinna-react": "workspace:*",
    "@legendapp/list": "3.7.1",
    "@legendapp/state": "3.0.0-beta.48",
    "alien-signals": "3.2.1",
    "big.js": "6.2.2",
    "expo": "55.0.32",
    "mobx": "7.1.7",
    "mobx-react-lite": "5.1.3",
    "react": "19.2.0",
    "react-native": "0.83.10"
  },
  "devDependencies": {
    "@babel/core": "7.29.6",
    "@babel/plugin-proposal-decorators": "7.29.0",
    "@babel/plugin-transform-class-properties": "7.28.6",
    "@babel/plugin-transform-private-methods": "7.28.6",
    "@babel/plugin-transform-private-property-in-object": "7.28.6",
    "@babel/plugin-transform-typescript": "7.29.9",
    "@types/babel__core": "7.20.5",
    "@types/big.js": "6.2.2",
    "@types/react": "19.2.18",
    "babel-preset-expo": "55.0.25"
  }
}
