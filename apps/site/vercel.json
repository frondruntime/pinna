{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "github": { "silent": true },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "Link", "value": "</llms.txt>; rel=\"describedby\"" }]
    },
    {
      "source": "/docs/(.*)\\.md",
      "headers": [{ "key": "Content-Type", "value": "text/markdown; charset=utf-8" }]
    }
  ]
}
