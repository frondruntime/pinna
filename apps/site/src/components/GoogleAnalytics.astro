---
/**
 * GA4, the snippet Frond's site uses. Renders only when analytics is enabled
 * and PUBLIC_GA_ID is set. The site is a subdomain of frondruntime.dev and
 * takes Frond's measurement ID, so the cookie on frondruntime.dev counts a
 * visitor once across both sites.
 */
import { analyticsEnabled } from "../lib/analytics";

const gaId = analyticsEnabled ? import.meta.env.PUBLIC_GA_ID : undefined;
---

{gaId && (
  <Fragment>
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
    <script is:inline set:html={`
      window.dataLayer = window.dataLayer || [];
      window.gtag = window.gtag || function gtag(){dataLayer.push(arguments);}

      function pinnaGaPageview() {
        const pageLocation = window.location.href;
        if (window.__pinnaGaLastPageLocation === pageLocation) return;

        window.__pinnaGaLastPageLocation = pageLocation;
        window.gtag('config', '${gaId}', {
          anonymize_ip: true,
          page_location: pageLocation,
          page_path: window.location.pathname + window.location.search + window.location.hash,
        });
      }

      if (!window.__pinnaGaAstroNavigation) {
        window.__pinnaGaAstroNavigation = true;
        window.gtag('js', new Date());
        pinnaGaPageview();
        document.addEventListener('astro:page-load', pinnaGaPageview);
      } else {
        pinnaGaPageview();
      }
    `} />
  </Fragment>
)}
