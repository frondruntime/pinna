---
import SharedSiteHeader from "@frondruntime/site-kit/components/SiteHeader.astro";
import { docsPath } from "../config/sidebar";
import { projectRepositoryUrl } from "../lib/siteMetadata";
import Brand from "./Brand.astro";

interface Props {
  current?: "docs" | "github" | "llms";
  showMenuToggle?: boolean;
}

const links = [
  { id: "docs", label: "Docs", href: docsPath("start") },
  { id: "github", label: "GitHub", href: projectRepositoryUrl, newTab: true },
  { id: "llms", label: "llms.txt", href: "/llms.txt", newTab: true },
];
---

<SharedSiteHeader brand={Brand} links={links} {...Astro.props} />
