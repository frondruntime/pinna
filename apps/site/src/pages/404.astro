---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { docsPath } from "../config/sidebar";
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteName } from "../lib/siteMetadata";
import "@frondruntime/site-kit/styles/page.css";

const title = `404 — ${siteName}`;
const description = "Nothing here reads this address.";
---

<BaseLayout title={title} description={description} indexable={false} bodyClass="short-page">
  <SiteHeader />

  <main class="page-main notfound-main">
    <div class="page-shell">
      <p class="page-eyebrow notfound-eyebrow">Not found</p>
      <h1 class="page-title notfound-title">
        <span>Nothing here</span>
        <span>was ever <span class="lit-word">read</span>.</span>
      </h1>
      <p class="page-lede">
        This address has no page. The URL may be wrong, or the page moved
        while Pinna is in developer preview.
      </p>
      <div class="page-actions">
        <a class="action page-action-primary" href="/">Back to home</a>
        <a class="action btn-secondary" href={docsPath("start")}>Read the docs</a>
      </div>
    </div>
  </main>

  <SiteFooter />
</BaseLayout>
