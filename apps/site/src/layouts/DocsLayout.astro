---
import "@frondruntime/site-kit/styles/docs.css";
import DocsShell from "@frondruntime/site-kit/components/DocsShell.astro";
import PreviewBanner from "@frondruntime/site-kit/components/PreviewBanner.astro";
import type { MarkdownHeading } from "astro";
import Brand from "../components/Brand.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { docsPath, sidebar } from "../config/sidebar";
import { siteDescription, siteName } from "../lib/siteMetadata";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description?: string;
  slug: string;
  /** Where the page's Markdown copy is served (`markdownPath` in `@frondruntime/site-kit/llms`). */
  markdownPath: string;
  headings: MarkdownHeading[];
}

const { title, description = siteDescription, slug, markdownPath, headings } = Astro.props;
---

<BaseLayout title={`${title} | ${siteName}`} description={description}>
  <link slot="head" rel="alternate" type="text/markdown" href={markdownPath} />

  <PreviewBanner
    label="v0 · Developer Preview"
    detail="Pinna is under active development. APIs may change between releases."
  />

  <SiteHeader current="docs" showMenuToggle />

  <DocsShell
    brand={Brand}
    title={title}
    slug={slug}
    headings={headings}
    sidebar={sidebar}
    contextLinks={[{ label: "Agent skills", href: `${docsPath("start")}#agent-skills` }]}
  >
    <slot />
    <SiteFooter slot="footer" />
  </DocsShell>
</BaseLayout>
