---
import SharedBaseLayout from "@frondruntime/site-kit/layouts/BaseLayout.astro";
import { site } from "../lib/siteMetadata";
import "../styles/site.css";

/** The shared document (`@frondruntime/site-kit`) with Pinna's identity and token values. */
interface Props {
  title: string;
  description?: string;
  indexable?: boolean;
  ogType?: "website" | "article";
  bodyClass?: string;
}
---

<SharedBaseLayout site={site} {...Astro.props}>
  <slot name="head" slot="head" />
  <slot />
</SharedBaseLayout>
